# Database (Supabase): pooler in modalità transaction per l'app, connessione diretta per le migrazioni
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Autenticazione (obbligatoria in produzione)
JWT_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Solo sviluppo: usa stripe-mock (docker run -p 12111:12111 stripe/stripe-mock)
# STRIPE_MOCK_URL=http://127.0.0.1:12111

# Sito pubblico (link nelle email e ritorno dal pagamento)
FRONTEND_URL=https://www.xn--cartoleriabamb-jrb.com

# Email (Resend)
RESEND_API_KEY=
FROM_EMAIL=
ADMIN_EMAIL=
# Solo sviluppo: tutte le email vanno a questo indirizzo
# TEST_EMAIL=

# Cloudinary (immagini prodotti)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Facoltative
# Stessa stringa nel frontend: aggiorna subito le pagine dopo le modifiche dal pannello
REVALIDATE_SECRET=
# Protegge il cron notturno /api/cleanup-carts
CRON_SECRET=
