generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            Int                  @id @default(autoincrement())
  email         String               @unique
  password      String
  name          String?
  role          Role                 @default(USER)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  addresses     Address[]
  cart          Cart?
  notifications Notification[]
  orders        Order[]
  resetTokens   PasswordResetToken[]
  wishlistItems WishlistItem[]
  reviews       Review[]
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id                         Int                  @id @default(autoincrement())
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  descrizione                String?
  immagine                   String?
  /// Immagini aggiuntive (galleria). `immagine` resta la copertina.
  immagini                   String[]             @default([])
  prezzo                     Decimal              @db.Decimal(10, 2)
  /// Prezzo in offerta: se valorizzato (e nella finestra di date) è il prezzo pagato.
  prezzoScontato             Decimal?             @db.Decimal(10, 2)
  scontoInizio               DateTime?
  scontoFine                 DateTime?
  titolo                     String
  marca                      String?
  /// Codice articolo / EAN
  codice                     String?
  stock                      Int                  @default(0)
  available                  Boolean              @default(true)
  /// Mostrato nella sezione "In evidenza" della home
  inEvidenza                 Boolean              @default(false)
  /// Il cliente può aggiungere un testo (es. nome da stampare)
  personalizzabile           Boolean              @default(false)
  etichettaPersonalizzazione String?
  /// Quantità massima acquistabile per ordine (null = nessun limite)
  maxPerOrdine               Int?
  cartItems                  CartItem[]
  orderItems                 OrderItem[]
  varianti                   ProductVariantType[]
  categoria                  Category[]           @relation("ProductCategories")
  promotions                 Promotion[]          @relation("ProductPromotions")
  wishlistItems              WishlistItem[]
  stockAlerts                StockAlert[]
  reviews                    Review[]

  @@index([available, createdAt])
  @@index([prezzoScontato])
  @@index([inEvidenza])
  @@index([marca])
}

/// Scheda di una marca (logo e descrizione). I prodotti restano legati col campo testo
/// `Product.marca`: la scheda si abbina tramite lo slug del nome.
model Brand {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  nome        String
  logo        String?
  descrizione String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Category {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  description String?
  immagine    String?
  /// Ordine manuale nel menu (più basso = prima)
  ordine      Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  parentId    Int?
  parent      Category?   @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[]  @relation("CategoryHierarchy")
  promotions  Promotion[] @relation("CategoryPromotions")
  products    Product[]   @relation("ProductCategories")

  @@index([parentId])
}

model Order {
  id                   Int                 @id @default(autoincrement())
  userId               Int?
  totalAmount          Decimal             @db.Decimal(10, 2)
  status               OrderStatus         @default(PENDING)
  paymentIntentId      String?             @unique
  /// Sessione Stripe Checkout che ha generato l'ordine (idempotenza webhook)
  stripeSessionId      String?             @unique
  trackingNumber       String? // Numero di tracking per la spedizione
  /// "spedizione" | "ritiro" | "giornata" (consegna in giornata)
  metodoConsegna       String?
  /// "stripe" | "contrassegno"
  metodoPagamento      String?
  commissionePagamento Decimal?            @db.Decimal(10, 2)
  subtotale            Decimal?            @db.Decimal(10, 2)
  costoSpedizione      Decimal?            @db.Decimal(10, 2)
  sconto               Decimal?            @db.Decimal(10, 2)
  codiceCoupon         String?
  /// Codice sconto usato (l'utilizzo viene prenotato alla creazione dell'ordine)
  promotionId          Int?
  /// Email di conferma al cliente inviata (per non perderla se il primo invio fallisce)
  emailInviataAt       DateTime?
  /// Dati per la fattura (se richiesta)
  richiestaFattura     Boolean             @default(false)
  ragioneSociale       String?
  partitaIva           String?
  codiceFiscale        String?
  codiceSdi            String?
  pec                  String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  shippingAddressId    Int?
  billingAddressId     Int?
  cap                  String?
  citta                String?
  cognome              String?
  guestEmail           String?
  nome                 String?
  note                 String?
  numero               String?
  stato                String?
  telefono             String?
  via                  String?
  billingAddress       Address?            @relation("BillingAddress", fields: [billingAddressId], references: [id])
  shippingAddress      Address?            @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  user                 User?               @relation(fields: [userId], references: [id])
  orderItems           OrderItem[]
  recessi              WithdrawalRequest[]

  @@index([userId])
  @@index([guestEmail])
  @@index([status, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id                Int      @id @default(autoincrement())
  orderId           Int
  productId         Int
  quantity          Int
  priceAtPurchase   Decimal  @db.Decimal(10, 2)
  /// Prezzo di listino al momento dell'acquisto (per mostrare lo sconto applicato)
  prezzoListino     Decimal? @db.Decimal(10, 2)
  /// Titolo al momento dell'acquisto: lo storico resta leggibile anche se il prodotto cambia
  titolo            String?
  selectedVariants  Json? // Nuove varianti selezionate (opzionale per backward compatibility)
  /// Firma delle varianti scelte (es. "52:310|53:320"): stesso prodotto in varianti diverse = righe diverse
  variantKey        String   @default("")
  personalizzazione String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  order             Order    @relation(fields: [orderId], references: [id])
  product           Product  @relation(fields: [productId], references: [id])

  @@unique([orderId, productId, variantKey])
  @@index([productId])
}

model Address {
  id                Int      @id @default(autoincrement())
  userId            Int
  street            String
  city              String
  postalCode        String
  country           String
  isDefaultShipping Boolean  @default(false)
  isDefaultBilling  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id])
  billingOrders     Order[]  @relation("BillingAddress")
  shippingOrders    Order[]  @relation("ShippingAddress")

  @@index([userId])
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
}

model CartItem {
  id                Int      @id @default(autoincrement())
  cartId            Int
  productId         Int
  quantity          Int
  selectedVariants  Json? // Nuove varianti selezionate (opzionale per backward compatibility)
  /// Vedi OrderItem.variantKey
  variantKey        String   @default("")
  personalizzazione String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  cart              Cart     @relation(fields: [cartId], references: [id])
  product           Product  @relation(fields: [productId], references: [id])

  @@unique([cartId, productId, variantKey])
  @@index([productId])
  @@index([updatedAt])
}

model Promotion {
  id                 Int        @id @default(autoincrement())
  name               String
  description        String?
  discountPercentage Decimal?   @db.Decimal(5, 2)
  discountAmount     Decimal?   @db.Decimal(10, 2)
  startDate          DateTime
  endDate            DateTime
  isActive           Boolean    @default(true)
  code               String?    @unique
  /// Importo minimo del carrello per usare il codice
  minimoOrdine       Decimal?   @db.Decimal(10, 2)
  /// Numero massimo di utilizzi (null = illimitato)
  maxUtilizzi        Int?
  utilizzi           Int        @default(0)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  categories         Category[] @relation("CategoryPromotions")
  products           Product[]  @relation("ProductPromotions")
}

model Notification {
  id                Int              @id @default(autoincrement())
  userId            Int?
  type              NotificationType
  message           String
  isRead            Boolean          @default(false)
  relatedEntityType String?
  relatedEntityId   Int?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  user              User?            @relation(fields: [userId], references: [id])

  @@index([userId])
}

model ProductVariantType {
  id        Int                   @id @default(autoincrement())
  nome      String
  productId Int
  product   Product               @relation(fields: [productId], references: [id])
  valori    ProductVariantValue[]

  @@index([productId])
}

model ProductVariantValue {
  id       Int                @id @default(autoincrement())
  nome     String
  immagine String?
  typeId   Int
  type     ProductVariantType @relation(fields: [typeId], references: [id])

  @@index([typeId])
}

/// Impostazioni del negozio modificabili dal pannello admin (chiave -> JSON)
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  nome      String?
  attivo    Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// "Avvisami quando torna disponibile"
model StockAlert {
  id         Int       @id @default(autoincrement())
  email      String
  productId  Int
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([email, productId])
  @@index([productId, notifiedAt])
}

model Review {
  id        Int      @id @default(autoincrement())
  productId Int
  userId    Int?
  nome      String
  voto      Int
  testo     String?
  approvata Boolean  @default(false)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, approvata])
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  /// "contatto" | "b2b" | "preventivo"
  tipo      String   @default("contatto")
  /// Campi aggiuntivi del form (ragione sociale, P.IVA, ...)
  dati      Json?
  nome      String
  email     String
  telefono  String?
  oggetto   String?
  messaggio String
  letto     Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum Role {
  USER
  ADMIN
  /// Solo il gestionale libri su /scuole, niente pannello del negozio
  SCUOLE
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  FAILED
  REFUNDED
}

enum NotificationType {
  ORDER_CONFIRMATION
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED_USER
  PASSWORD_RESET_REQUEST
  ACCOUNT_UPDATED
  NEW_ORDER_PLACED_ADMIN
  LOW_STOCK_WARNING_ADMIN
  ORDER_CANCELLED_BY_USER_ADMIN
  NEW_USER_REGISTERED_ADMIN
  PRODUCT_REVIEW_SUBMITTED_ADMIN
  CONTACT_FORM_SUBMITTED_ADMIN
}

/// Recesso online (diritto di ripensamento, art. 52 Codice del Consumo)
model WithdrawalRequest {
  id        Int      @id @default(autoincrement())
  orderId   Int
  email     String
  nome      String
  /// Articoli oggetto del recesso: [{ orderItemId, titolo, quantity }]
  articoli  Json
  motivo    String?
  note      String?
  /// "ricevuta" | "accettata" | "rifiutata" | "rimborsata"
  stato     String   @default("ricevuta")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order    @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

/// Articoli del blog
model Post {
  id          Int       @id @default(autoincrement())
  titolo      String
  slug        String    @unique
  estratto    String?
  contenuto   String
  copertina   String?
  pubblicato  Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([pubblicato, publishedAt])
}

// ── Gestionale libri scolastici (ex GS_MAG) ──────────────────────────────

/// Scuola dall'anagrafe del Ministero (codice meccanografico)
model Scuola {
  id        Int            @id @default(autoincrement())
  codice    String         @unique
  nome      String
  tipo      String?
  indirizzo String?
  cap       String?
  citta     String?
  provincia String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  schede    SchedaScuola[]
  clienti   SchedaCliente[]
}

/// Libri adottati da una classe in un anno (ex Schede_Testata). L'anno è quello solare, come in GS_MAG.
model SchedaScuola {
  id        Int                 @id @default(autoincrement())
  scuolaId  Int
  scuola    Scuola              @relation(fields: [scuolaId], references: [id], onDelete: Restrict)
  anno      Int
  /// Anno di corso e sezione attaccati, come li scrive il Ministero («1A», «3ASA»)
  classe    String
  corso     String              @default("")
  data      DateTime            @default(now())
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  libri     SchedaScuolaLibro[]

  @@unique([scuolaId, anno, classe, corso])
  @@index([anno])
}

/// Un libro adottato nella classe (ex Schede_Dettaglio)
model SchedaScuolaLibro {
  id            Int          @id @default(autoincrement())
  schedaId      Int
  scheda        SchedaScuola @relation(fields: [schedaId], references: [id], onDelete: Cascade)
  isbn          String
  materia       String
  autori        String
  titolo        String
  volume        String
  editore       String
  prezzo        Decimal      @db.Decimal(10, 2)
  nuovaAdozione Boolean      @default(false)
  daAcquistare  Boolean      @default(false)
  consigliato   Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([schedaId, isbn])
  @@index([isbn])
}

/// Stato di un libro nella scheda del cliente, con i nomi del negozio (in GS_MAG: non confermato,
/// confermato, ordinato, arrivato, consegnato)
enum StatoLibroCliente {
  IN_LISTA
  PRENOTATO
  CONFERMATO
  ASSEGNATO
  RITIRATO
}

/// Scheda di prenotazione dei libri di un alunno (ex Cliente_Testata). Numero progressivo per anno solare.
model SchedaCliente {
  id        Int                  @id @default(autoincrement())
  anno      Int
  numero    Int
  cognome   String
  nome      String
  telefono  String               @default("")
  scuolaId  Int
  scuola    Scuola               @relation(fields: [scuolaId], references: [id], onDelete: Restrict)
  /// Come nelle schede della scuola: «1A», «3ASA»
  classe    String
  corso     String               @default("")
  acconto   Decimal              @default(0) @db.Decimal(10, 2)
  note      String               @default("")
  data      DateTime             @default(now())
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  libri     SchedaClienteLibro[]

  @@unique([anno, numero])
  @@index([scuolaId, anno, classe])
  @@index([cognome])
}

/// Un libro (una copia) nella scheda del cliente (ex Cliente_Dettaglio)
model SchedaClienteLibro {
  id            Int               @id @default(autoincrement())
  schedaId      Int
  scheda        SchedaCliente     @relation(fields: [schedaId], references: [id], onDelete: Cascade)
  isbn          String
  materia       String
  autori        String
  titolo        String
  volume        String
  editore       String
  prezzo        Decimal           @db.Decimal(10, 2)
  nuovaAdozione Boolean           @default(false)
  daAcquistare  Boolean           @default(false)
  consigliato   Boolean           @default(false)
  stato         StatoLibroCliente @default(IN_LISTA)
  prenotatoAt   DateTime?
  confermatoAt  DateTime?
  assegnatoAt   DateTime?
  ritiratoAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  rigaOrdine    OrdineRiga?

  @@unique([schedaId, isbn])
  @@index([isbn, stato])
}

/// Ordine al fornitore (ex Ordine_Testata). Un solo fornitore: niente anagrafica, solo appunti.
model OrdineFornitore {
  id        Int          @id @default(autoincrement())
  anno      Int
  numero    Int
  data      DateTime     @default(now())
  note      String       @default("")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  righe     OrdineRiga[]

  @@unique([anno, numero])
}

/// Una copia ordinata (ex Ordine_Dettaglio). È del cliente che l'ha prenotata; senza cliente è «libera»
/// (il cliente l'ha annullata e nessun altro la aspettava) e va al prossimo che prenota lo stesso libro.
model OrdineRiga {
  id         Int                 @id @default(autoincrement())
  ordineId   Int
  ordine     OrdineFornitore     @relation(fields: [ordineId], references: [id], onDelete: Cascade)
  isbn       String
  materia    String
  autori     String
  titolo     String
  volume     String
  editore    String
  prezzo     Decimal             @db.Decimal(10, 2)
  libroId    Int?                @unique
  libro      SchedaClienteLibro? @relation(fields: [libroId], references: [id], onDelete: SetNull)
  /// Lo scrive la sezione Bolle all'arrivo della merce
  arrivatoAt DateTime?
  createdAt  DateTime            @default(now())

  @@index([ordineId])
  @@index([isbn, arrivatoAt])
}
